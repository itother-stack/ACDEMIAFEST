Options -Indexes
# Home page = React website (index.html); other folders use index.php
DirectoryIndex index.html index.php

# Block direct browser access to sensitive files
<FilesMatch "^(config\.php|db\.php|database\.sql|README.*)$">
    Require all denied
</FilesMatch>

# Cache build files for a long time (their names contain a content hash)
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType application/javascript "access plus 1 year"
    ExpiresByType image/webp "access plus 30 days"
    ExpiresByType image/jpeg "access plus 30 days"
    ExpiresByType image/png "access plus 30 days"
</IfModule>
<IfModule mod_headers.c>
    <FilesMatch "^index\.html$">
        Header set Cache-Control "no-cache"
    </FilesMatch>
</IfModule>
